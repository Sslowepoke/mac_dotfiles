# auto update
# YABAI_CERT=yabai-cert sh -c "$(curl -fsSL "https://git.io/update-yabai")" &

yabai -m signal --add event=dock_did_restart action="sudo yabai --load-sa"
sudo yabai --load-sa

yabai -m config layout bsp

# Space labels
yabai -m space 1 --label main
yabai -m space 2 --label web
yabai -m space 3 --label chat
yabai -m space 4 --label whatsapp
yabai -m space 5 --label music
yabai -m space 9 --label notes


yabai -m rule --add app="^Zen$" space=web
yabai -m rule --add app="^Discord$" space=chat
yabai -m rule --add app="^Spotify$" space=music
yabai -m rule --add app="^WhatsApp$" space=whatsapp
yabai -m rule --add app="^Obsidian$" space=notes

# yabai -m space 1 --layout float

# Window rules
yabai -m rule --add app="^(Calculator|System Preferences|System Settings|Archive Utility|Finder)$" manage=off
yabai -m rule --add title="^Preferences" manage=off
yabai -m rule --add title="^Settings" manage=off
yabai -m rule --add app="^Steam$" manage=off
yabai -m rule --add app="^League of Legends$" manage=off
yabai -m rule --add app="^Notes$" manage=off
yabai -m rule --add app="^QuickTime Player$" manage=off
yabai -m rule --add app="^Weather$" manage=off
yabai -m rule --add app="^rectangle" manage=off
yabai -m rule --add app="^League of Legends$" manage=off
yabai -m rule --add app="^MATLAB_R2025a$" manage=off
# matlab plotovi
yabai -m rule --add title="^Figure.*" manage=off
yabai -m rule --add app="^Microsoft Teams$" manage=off
yabai -m rule --add app="^Figures$" manage=off


